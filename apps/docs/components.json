{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "base-nova",
  "rsc": true,
  "tsx": true,
  "tailwind": {
    "config": "",
    "css": "app/globals.css",
    "baseColor": "neutral",
    "cssVariables": true,
    "prefix": ""
  },
  "iconLibrary": "lucide",
  "rtl": false,
  "aliases": {
    "components": "@/registry",
    "utils": "@/lib/utils",
    "ui": "@/registry/base",
    "lib": "@/lib",
    "hooks": "@/hooks"
  },
  "menuColor": "default",
  "menuAccent": "subtle",
  "registries": {
    "@thienui": "http://localhost:4321/r/{name}.json",
    "@seamui": "https://seamui.dev/r/{name}.json",
    "@kibo-ui": "https://www.kibo-ui.com/r/{name}.json",
    "@niko-table": "https://niko-table.com/r/{name}.json",
    "@evilcharts": "https://evilcharts.com/r/{name}.json",
    "@animate-ui": "https://animate-ui.com/r/{name}.json",
    "@ai-elements": "https://ai-sdk.dev/elements/api/registry/{name}.json"
  }
}