{
  "name": "@thienui/docs",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "next dev -p 4321",
    "build": "pnpm registry:build && next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "registry:build": "pnpm registry:gen && shadcn build registry.json -o public/r",
    "registry:validate": "shadcn registry validate registry.json",
    "guards": "thienui-guards --root ../..",
    "registry:gen": "node scripts/build-registry.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@tanstack/react-table": "^8.21.3",
    "@thienui/guards": "workspace:*",
    "@thienui/tokens": "workspace:*",
    "@thienui/ui-patterns": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "1.51.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.2.8",
    "react-resizable-panels": "^4.14.2",
    "recharts": "3.8.0",
    "shadcn": "^4.21.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@thienui/tsconfig": "workspace:*",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}