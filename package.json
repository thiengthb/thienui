{
  "name": "thienui",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @thienui/docs dev",
    "tokens": "pnpm --filter @thienui/tokens build",
    "guards": "node packages/guards/bin/guards.mjs --root .",
    "registry": "pnpm --filter @thienui/docs registry:build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "build": "turbo run build",
    "verify": "pnpm tokens && pnpm guards && pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "turbo": "^2.6.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "prettier": "^3.9.6",
    "@thienui/guards": "workspace:*"
  }
}